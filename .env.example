# Copy this file to .env and fill in your keys. Never commit .env.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Hold these keys together to dictate (pynput names: ctrl, cmd = Win key, alt, shift)
HOTKEY=ctrl+cmd

# Speech-to-text (Groq)
ASR_MODEL=whisper-large-v3-turbo
# Empty: Whisper detects the language (Hindi stays Hindi, then becomes Hinglish or English). "en" forces English and drops most Hindi speech.
LANGUAGE=

# Cleanup LLM: groq (fast, uses GROQ_API_KEY) or openrouter (uses OPENROUTER_API_KEY)
CLEANUP_PROVIDER=groq
CLEANUP_MODEL=qwen/qwen3.8-27b
# Used once if the main model fails (rate limit, overload, timeout after CLEANUP_TIMEOUT seconds)
FALLBACK_MODEL=openai/gpt-oss-120b
CLEANUP_TIMEOUT=6

# Comma-separated models for benchmark.py (same provider as CLEANUP_PROVIDER)
BENCHMARK_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b
