<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ink"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="14dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minLines="2"
        android:text="@string/kb_ready"
        android:textColor="@color/kb_text"
        android:textSize="14sp" />

    <FrameLayout
        android:id="@+id/mic"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/mic_button"
        android:contentDescription="@string/kb_mic">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_mic" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/switchKeyboard"
            style="@style/KbKey"
            android:layout_weight="1"
            android:contentDescription="@string/kb_switch"
            android:text="⌨" />

        <TextView
            android:id="@+id/space"
            style="@style/KbKey"
            android:layout_weight="3"
            android:text="@string/kb_space" />

        <TextView
            android:id="@+id/backspace"
            style="@style/KbKey"
            android:layout_weight="1"
            android:contentDescription="@string/kb_backspace"
            android:text="⌫" />

        <TextView
            android:id="@+id/enter"
            style="@style/KbKey"
            android:layout_weight="1"
            android:contentDescription="@string/kb_enter"
            android:text="↵" />
    </LinearLayout>
</LinearLayout>
