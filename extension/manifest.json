{
  "manifest_version": 3,
  "name": "Saylo",
  "version": "0.1.0",
  "description": "Hold Alt + Shift in any text box, speak, let go: Saylo types clean text for you.",
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "action": {"default_title": "Saylo setup", "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}},
  "background": {"service_worker": "background.js", "type": "module"},
  "options_page": "welcome.html",
  "permissions": ["offscreen", "storage"],
  "host_permissions": ["https://api.groq.com/*"],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "all_frames": true,
    "run_at": "document_start"
  }]
}
